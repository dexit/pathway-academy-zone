# ─── React SPA (Vite) ────────────────────────────────────────────────────────

# WordPress REST API base URL (must end without trailing slash)
# VITE_WP_API_URL=https://pathwayacademyzone.co.uk/wp-json

# OpenRouter API key (browser-side — use wp-proxy provider to keep it server-side instead)
# VITE_OPENROUTER_API_KEY=sk-or-...

# Local AI (Ollama-compatible) base URL for browser-side calls
# VITE_LOCAL_AI_URL=http://localhost:11434

# Web Vitals reporting endpoint
# VITE_VITALS_ENDPOINT=/api/vitals

# ─── WordPress (wp-config.php constants) ─────────────────────────────────────

# REST API auth token for email-sending endpoint
# define( 'PAZ_REST_TOKEN', 'your-secret-token' );

# OpenRouter API key (server-side — never exposed to browser)
# define( 'PAZ_OPENROUTER_API_KEY', 'sk-or-...' );

# Local AI URL (Ollama-compatible)
# define( 'PAZ_LOCAL_AI_URL', 'http://localhost:11434' );

# Comma-separated CORS allowed origins
# define( 'PAZ_CORS_ORIGINS', 'https://academy.pathwayl.ink,https://pathwayacademyzone.co.uk' );

# SPA base URL for iframe embed block
# define( 'PAZ_SPA_BASE_URL', 'https://academy.pathwayl.ink' );

# SMTP configuration
# define( 'PAZ_SMTP_HOST',      'smtp.example.com' );
# define( 'PAZ_SMTP_PORT',      587 );
# define( 'PAZ_SMTP_USER',      'user@example.com' );
# define( 'PAZ_SMTP_PASS',      'password' );
# define( 'PAZ_SMTP_FROM',      'noreply@pathwayacademyzone.co.uk' );
# define( 'PAZ_SMTP_FROM_NAME', 'Pathway Academy Zone' );

# ─── Build ────────────────────────────────────────────────────────────────────

# Set to "1" to copy dist/ to wpsys/wp-content/uploads/paz-spa/ after build
# COPY_TO_WP=1
