# ─── React SPA (Vite) ────────────────────────────────────────────────────────

# WordPress REST API base URL (must end without trailing slash)
# VITE_WP_API_URL=https://pathwayacademyzone.co.uk/wp-json

# ── Page analytics ────────────────────────────────────────────────────────────
# VITE_GTM_ID=GTM-XXXXXXX
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_CLARITY_ID=xxxxxxxxxx
# VITE_CF_ANALYTICS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_PLAUSIBLE_DOMAIN=academy.pathwayl.ink

# ── Ads / conversion tracking ─────────────────────────────────────────────────
# VITE_GOOGLE_ADS_ID=AW-123456789
# VITE_GOOGLE_ADS_CONVERSION_LABEL=AbCdEfGhIjK
# VITE_BING_UET_ID=123456789
# VITE_META_PIXEL_ID=123456789012345
# VITE_LINKEDIN_PARTNER_ID=1234567
# VITE_TIKTOK_PIXEL_ID=ABCDEFGHIJKLMNOP

# ── HubSpot CRM ───────────────────────────────────────────────────────────────
# VITE_HUBSPOT_PORTAL_ID=12345678
# VITE_HUBSPOT_REGION=eu1
# VITE_HUBSPOT_CHAT=true
# VITE_HUBSPOT_CHAT_PORTAL_ID=12345678

# ── Search engine verification meta tags ──────────────────────────────────────
# VITE_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_BING_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_YANDEX_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_FACEBOOK_DOMAIN=xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_PINTEREST_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_APPLE_MAPS_TOKEN=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6IlhYWFhYWFhYWFgifQ...

# ── IndexNow ──────────────────────────────────────────────────────────────────
# VITE_INDEXNOW_KEY=0a91f3c8e29d4d6b9c6f4e5b3a8d7c2f

# ── AI ────────────────────────────────────────────────────────────────────────
# VITE_OPENROUTER_API_KEY=sk-or-...
# VITE_LOCAL_AI_URL=http://localhost:11434

# ── Observability ─────────────────────────────────────────────────────────────
# VITE_VITALS_ENDPOINT=/api/vitals


# ─── WordPress (wp-config.php constants) ─────────────────────────────────────

# REST API auth token for email-sending endpoint
# define( 'PAZ_REST_TOKEN', 'your-secret-token' );

# IndexNow key (must match /{key}.txt file served at the domain root)
# define( 'PAZ_INDEXNOW_KEY', '0a91f3c8e29d4d6b9c6f4e5b3a8d7c2f' );

# OpenRouter API key (server-side — never exposed to browser)
# define( 'PAZ_OPENROUTER_API_KEY', 'sk-or-...' );

# Local AI URL (Ollama-compatible)
# define( 'PAZ_LOCAL_AI_URL', 'http://localhost:11434' );

# Comma-separated CORS allowed origins
# define( 'PAZ_CORS_ORIGINS', 'https://academy.pathwayl.ink,https://pathwayacademyzone.co.uk' );

# SPA base URL for iframe embed block
# define( 'PAZ_SPA_BASE_URL', 'https://academy.pathwayl.ink' );

# SMTP configuration
# define( 'PAZ_SMTP_HOST',      'smtp.example.com' );
# define( 'PAZ_SMTP_PORT',      587 );
# define( 'PAZ_SMTP_USER',      'user@example.com' );
# define( 'PAZ_SMTP_PASS',      'password' );
# define( 'PAZ_SMTP_FROM',      'noreply@pathwayacademyzone.co.uk' );
# define( 'PAZ_SMTP_FROM_NAME', 'Pathway Academy Zone' );

# ─── Build ────────────────────────────────────────────────────────────────────

# Set to "1" to copy dist/ to wpsys/wp-content/uploads/paz-spa/ after build
# COPY_TO_WP=1
