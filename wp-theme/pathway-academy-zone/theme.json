{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"palette": [
				{ "name": "Background",          "slug": "background",          "color": "hsl(120, 20%, 99%)" },
				{ "name": "Foreground",          "slug": "foreground",          "color": "hsl(160, 10%, 15%)" },
				{ "name": "Primary",             "slug": "primary",             "color": "hsl(152, 45%, 35%)" },
				{ "name": "Primary Dark",        "slug": "primary-dark",        "color": "hsl(152, 50%, 45%)" },
				{ "name": "Primary Foreground",  "slug": "primary-foreground",  "color": "#ffffff" },
				{ "name": "Accent",              "slug": "accent",              "color": "hsl(152, 35%, 90%)" },
				{ "name": "Accent Foreground",   "slug": "accent-foreground",   "color": "hsl(152, 30%, 20%)" },
				{ "name": "Muted",               "slug": "muted",               "color": "hsl(120, 10%, 95%)" },
				{ "name": "Muted Foreground",    "slug": "muted-foreground",    "color": "hsl(160, 8%, 45%)" },
				{ "name": "Border",              "slug": "border",              "color": "hsl(140, 12%, 88%)" },
				{ "name": "Card",                "slug": "card",                "color": "#ffffff" },
				{ "name": "Secondary",           "slug": "secondary",           "color": "hsl(140, 15%, 92%)" },
				{ "name": "Footer Background",   "slug": "footer-bg",           "color": "hsl(160, 22%, 9%)" },
				{ "name": "Destructive",         "slug": "destructive",         "color": "#c0392b" }
			],
			"gradients": [
				{ "name": "Primary Gradient", "slug": "primary-gradient", "gradient": "linear-gradient(135deg, hsl(152, 45%, 35%) 0%, hsl(152, 50%, 45%) 100%)" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "System UI",
					"slug": "system-ui",
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"name": "Plus Jakarta Sans",
					"slug": "plus-jakarta-sans",
					"fontFamily": "\"Plus Jakarta Sans\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "size": "0.75rem",  "name": "XS",    "slug": "xs" },
				{ "size": "0.875rem", "name": "SM",    "slug": "sm" },
				{ "size": "1rem",     "name": "Base",  "slug": "base" },
				{ "size": "1.125rem", "name": "LG",    "slug": "lg" },
				{ "size": "1.25rem",  "name": "XL",    "slug": "xl" },
				{ "size": "1.5rem",   "name": "2XL",   "slug": "2xl" },
				{ "size": "1.875rem", "name": "3XL",   "slug": "3xl" },
				{ "size": "2.25rem",  "name": "4XL",   "slug": "4xl" },
				{ "size": "3rem",     "name": "5XL",   "slug": "5xl" },
				{ "size": "clamp(2.5rem, 4vw + 1rem, 4rem)", "name": "Display", "slug": "display" }
			],
			"fontWeight": true,
			"fontStyle": true,
			"textTransform": true,
			"lineHeight": true,
			"letterSpacing": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": ["px", "em", "rem", "%", "vh", "vw"],
			"spacingSizes": [
				{ "size": "4px",   "slug": "1",  "name": "1" },
				{ "size": "8px",   "slug": "2",  "name": "2" },
				{ "size": "12px",  "slug": "3",  "name": "3" },
				{ "size": "16px",  "slug": "4",  "name": "4" },
				{ "size": "20px",  "slug": "5",  "name": "5" },
				{ "size": "24px",  "slug": "6",  "name": "6" },
				{ "size": "28px",  "slug": "7",  "name": "7" },
				{ "size": "32px",  "slug": "8",  "name": "8" },
				{ "size": "36px",  "slug": "9",  "name": "9" },
				{ "size": "40px",  "slug": "10", "name": "10" },
				{ "size": "44px",  "slug": "11", "name": "11" },
				{ "size": "48px",  "slug": "12", "name": "12" },
				{ "size": "56px",  "slug": "14", "name": "14" },
				{ "size": "64px",  "slug": "16", "name": "16" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"border-radius": {
				"small":  "6px",
				"medium": "12px",
				"large":  "16px",
				"full":   "9999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-ui)",
			"fontSize": "1rem",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-ui)",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--4xl)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--2xl)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"button": {
				"border": { "radius": "0.75rem" },
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": { "fontWeight": "600", "fontSize": "0.95rem" },
				":hover": { "color": { "background": "hsl(152, 45%, 28%)" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header",           "title": "Header",           "area": "header" },
		{ "name": "footer",           "title": "Footer",           "area": "footer" },
		{ "name": "sidebar",          "title": "Sidebar",          "area": "uncategorized" },
		{ "name": "announcement-bar", "title": "Announcement Bar", "area": "uncategorized" },
		{ "name": "cta-banner",       "title": "CTA Banner",       "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-full-width",    "title": "Full Width Page",    "postTypes": ["page"] },
		{ "name": "page-landing",       "title": "Landing Page",       "postTypes": ["page"] },
		{ "name": "page-with-sidebar",  "title": "Page with Sidebar",  "postTypes": ["page", "post"] },
		{ "name": "page-contact",       "title": "Contact Page",       "postTypes": ["page"] },
		{ "name": "page-knowledge-hub", "title": "Knowledge Hub Page", "postTypes": ["page"] },
		{ "name": "page-policies",      "title": "Policies Page",      "postTypes": ["page"] },
		{ "name": "page-partners",      "title": "Partners Page",      "postTypes": ["page"] },
		{ "name": "page-case-studies",  "title": "Case Studies Page",  "postTypes": ["page"] },
		{ "name": "page-testimonials",  "title": "Testimonials Page",  "postTypes": ["page"] },
		{ "name": "page-vacancies",     "title": "Vacancies Page",     "postTypes": ["page"] }
	]
}
