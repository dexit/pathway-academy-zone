# Netlify-style redirects for Vercel CLI local testing
# This mirrors vercel.json SPA fallback behavior

# Static assets — cache indefinitely
/assets/* /assets/:splat 200

# Static files with cache headers
/favicon.ico /favicon.ico 200
/robots.txt /robots.txt 200
/sitemap.xml /sitemap.xml 200
/llms.txt /llms.txt 200
/sw.js /sw.js 200
/site.webmanifest /site.webmanifest 200
/oembed /oembed.json 200
/oembed.json /oembed.json 200

# SPA fallback — route all unmatched paths to index.html for client-side routing
/* /index.html 200
