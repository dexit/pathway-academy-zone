<mjml>
  <mj-head>
    <mj-title>Application Received — Pathway Academy Zone</mj-title>
    <mj-preview>Thank you for your interest in working with Pathway Academy Zone, {{firstName}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', Arial, Helvetica, sans-serif" />
      <mj-text font-size="14px" line-height="1.65" color="#1a2c24" padding="0 0 12px 0" />
      <mj-section padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f0f5f2">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <mj-section background-color="#2e8158" padding="32px 32px 28px">
      <mj-column>
        <mj-image src="https://pathwayacademyzone.co.uk/assets/PAZlogo-BYea4nq1.png"
                  width="152px" alt="Pathway Academy Zone" align="left" />
        <mj-text color="#ffffff" font-size="22px" font-weight="800" padding="18px 0 4px">
          Application Received
        </mj-text>
        <mj-text color="rgba(255,255,255,0.8)" font-size="14px" padding="0">
          Thank you for your interest in joining the Pathway Academy Zone team.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#1d6645" padding="4px 0" />

    <!-- ── Body ─────────────────────────────────────────────── -->
    <mj-section background-color="#ffffff" padding="36px 32px 28px">
      <mj-column>
        <mj-text font-size="15px" line-height="1.7">
          Hello {{firstName}},
        </mj-text>
        <mj-text font-size="14px" line-height="1.7" color="#3a5047">
          Thank you for submitting a speculative application to Pathway Academy Zone. We are always on the look-out for talented, passionate people who share our commitment to supporting young people.
        </mj-text>
        <mj-text font-size="14px" line-height="1.7" color="#3a5047">
          A member of our team will review your application and be in touch if there is a suitable opportunity. We keep applications on file for <strong>6 months</strong>, so even if we can't reach out straight away, we may get in touch when the right role arises.
        </mj-text>

        <!-- Summary -->
        <mj-divider border-color="#e8f0eb" border-width="1px" padding="12px 0" />
        <mj-text font-size="13px" font-weight="700" color="#2e8158" padding="0 0 12px">
          YOUR APPLICATION SUMMARY
        </mj-text>

        <mj-table cellpadding="0" cellspacing="0" width="100%">
          <tr>
            <td style="padding:8px 16px 8px 0;width:38%;border-bottom:1px solid #e8f0eb;vertical-align:top;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#677e77;">Name</td>
            <td style="padding:8px 0;border-bottom:1px solid #e8f0eb;font-size:13px;font-weight:600;color:#1a2c24;">{{firstName}} {{lastName}}</td>
          </tr>
          <tr>
            <td style="padding:8px 16px 8px 0;vertical-align:top;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#677e77;">Area of Interest</td>
            <td style="padding:8px 0;font-size:13px;font-weight:600;color:#1a2c24;">{{interest}}</td>
          </tr>
        </mj-table>

        <!-- What happens next -->
        <mj-divider border-color="#e8f0eb" border-width="1px" padding="18px 0 12px" />
        <mj-text font-size="13px" font-weight="700" color="#2e8158" padding="0 0 12px">
          WHAT HAPPENS NEXT
        </mj-text>

        <mj-table cellpadding="0" cellspacing="0" width="100%">
          <tr>
            <td style="width:36px; padding:8px 12px 8px 0; vertical-align:top">
              <div style="width:28px;height:28px;border-radius:50%;background:#2e8158;color:#fff;font-weight:800;font-size:12px;text-align:center;line-height:28px;">1</div>
            </td>
            <td style="padding:8px 0; font-size:13px; color:#3a5047; border-bottom:1px solid #e8f0eb">
              <strong>Review</strong> — Your application is read by our HR team and relevant department heads.
            </td>
          </tr>
          <tr>
            <td style="padding:8px 12px 8px 0; vertical-align:top">
              <div style="width:28px;height:28px;border-radius:50%;background:#2e8158;color:#fff;font-weight:800;font-size:12px;text-align:center;line-height:28px;">2</div>
            </td>
            <td style="padding:8px 0; font-size:13px; color:#3a5047; border-bottom:1px solid #e8f0eb">
              <strong>On file</strong> — We retain your details for 6 months and will reach out if a relevant vacancy arises.
            </td>
          </tr>
          <tr>
            <td style="padding:8px 12px 8px 0; vertical-align:top">
              <div style="width:28px;height:28px;border-radius:50%;background:#2e8158;color:#fff;font-weight:800;font-size:12px;text-align:center;line-height:28px;">3</div>
            </td>
            <td style="padding:8px 0; font-size:13px; color:#3a5047">
              <strong>Interview</strong> — If your skills match a role, we'll invite you to an informal conversation.
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- ── Vacancies ──────────────────────────────────────────── -->
    <mj-section background-color="#e8f4ee" padding="24px 32px">
      <mj-column>
        <mj-text font-size="13px" font-weight="700" color="#2e8158" padding="0 0 12px">
          KEEP AN EYE ON LIVE VACANCIES
        </mj-text>
        <mj-text font-size="13px" line-height="1.8" color="#3a5047">
          · <a href="https://pathwayacademyzone.co.uk/careers" style="color:#2e8158">Current Vacancies</a> — Browse our live job listings<br />
          · <a href="https://pathwayacademyzone.co.uk/about" style="color:#2e8158">About Us</a> — Learn more about our mission and values<br />
          · <a href="https://pathwayacademyzone.co.uk/contact" style="color:#2e8158">Contact Us</a> — Get in touch with any questions
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ── Footer ───────────────────────────────────────────── -->
    <mj-section background-color="#1a2c24" padding="28px 32px">
      <mj-column>
        <mj-text color="rgba(255,255,255,0.7)" font-size="13px" font-weight="600" padding="0 0 6px">
          Pathway Academy Zone
        </mj-text>
        <mj-text color="rgba(255,255,255,0.5)" font-size="11px" line-height="1.8">
          Duncalf St, Burslem, Stoke-on-Trent ST6 3LJ<br />
          <a href="tel:+441782365365" style="color:rgba(255,255,255,0.5)">01782 365365</a> ·
          <a href="mailto:info@pathwayacademyzone.co.uk" style="color:rgba(255,255,255,0.5)">info@pathwayacademyzone.co.uk</a>
        </mj-text>
        <mj-text color="rgba(255,255,255,0.35)" font-size="10px" padding="12px 0 0">
          You received this email because you submitted a speculative application at pathwayacademyzone.co.uk.
          Your details will be held securely and deleted after 6 months if no suitable role arises.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
