{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pazone/programme-card",
	"title": "Programme Card",
	"category": "paz",
	"icon": "welcome-learn-more",
	"description": "Renders one paz_programme post as a card or a grid of all programmes, with optional area filtering.",
	"textdomain": "pathway-academy-zone",
	"supports": { "html": false, "align": ["wide", "full"] },
	"attributes": {
		"postId":       { "type": "number",  "default": 0 },
		"limit":        { "type": "number",  "default": 6 },
		"columns":      { "type": "number",  "default": 3 },
		"showExcerpt":  { "type": "boolean", "default": true },
		"filterByArea": { "type": "string",  "default": "" },
		"heading":      { "type": "string",  "default": "" },
		"ctaLabel":     { "type": "string",  "default": "Learn more" }
	},
	"render": "file:./render.php"
}
