{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pazone/related-content",
	"title": "Related Content",
	"category": "paz",
	"icon": "randomize",
	"description": "Displays related posts sharing taxonomy terms with the current post.",
	"textdomain": "pathway-academy-zone",
	"supports": { "html": false, "align": ["wide", "full"] },
	"attributes": {
		"heading":    { "type": "string", "default": "Related Resources" },
		"postType":   { "type": "string", "default": "paz_resource" },
		"limit":      { "type": "number", "default": 3 },
		"columns":    { "type": "number", "default": 3 },
		"taxonomies": {
			"type":    "array",
			"default": ["paz_resource_category", "paz_area_served"]
		}
	},
	"render": "file:./render.php"
}
